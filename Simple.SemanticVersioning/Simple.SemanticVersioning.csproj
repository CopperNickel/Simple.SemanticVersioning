<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Semantic Version</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>Simple.SemanticVersion</Title>
    <Description>Semantic Version</Description>
    <Copyright>Copyright (c) 2026 Dmitrii Bychenko</Copyright>
    <PackageProjectUrl>https://github.com/CopperNickel/Simple.SemanticVersioning.git</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CopperNickel/Simple.SemanticVersioning.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Semver;Semantic;Versioning</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
<Authors>Dmitrii Bychenko</Authors>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageReleaseNotes>Semantic Version (senver) initial version</PackageReleaseNotes>
    <NeutralLanguage>en-US</NeutralLanguage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
