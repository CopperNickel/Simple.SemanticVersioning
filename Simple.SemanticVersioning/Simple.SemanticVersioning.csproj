<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Semantic Version</AssemblyTitle>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>Simple.SemanticVersion</Title>
    <Description>Semantic Version</Description>
    <Copyright>Copyright (c) 2026 Dmitrii Bychenko</Copyright>
    <PackageProjectUrl>https://github.com/CopperNickel/Simple.SemanticVersioning.git</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CopperNickel/Simple.SemanticVersioning.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>SemanticVersion</PackageTags>
    <PackageIcon>..\icon.png</PackageIcon>
    <Authors>Dmitrii Bychenko</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
